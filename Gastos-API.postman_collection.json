    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.accessToken) pm.collectionVariables.set('accessToken', r.accessToken);",
                  "if (r.refreshToken) pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "pm.collectionVariables.set('recoveryKey', r.recoveryKey);",
                  "console.log('GUARDA tu recoveryKey:', r.recoveryKey);",
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
